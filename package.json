{
  "name": "one-sun-one-moon",
  "version": "1.0.0",
  "private": true,
  "description": "ONE SUN ONE MOON — website for the digital marketing & creative agency (onesunonemoon.in).",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
