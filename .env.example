# Copy to .env.local for development; set the same names in the hosting dashboard
# for production. Every value here is a placeholder: never commit real secrets.

# Canonical production origin (no trailing slash). Used for canonical URLs,
# sitemap, Open Graph and the contact form's origin check.
SITE_URL=https://onesunonemoon.in

# --- Contact form email delivery (Resend, https://resend.com) ---------------
# Server-only. Until all three are set, the form tells visitors that online
# enquiries are not connected yet and nothing is reported as sent.
RESEND_API_KEY=
# Inbox that receives enquiries.
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. "ONE SUN ONE MOON <enquiries@onesunonemoon.in>".
CONTACT_FROM_EMAIL=

# --- Public business details (optional) --------------------------------------
# Shown on the site only when set. Leave blank rather than guessing.
PUBLIC_CONTACT_EMAIL=
# WhatsApp Business number, country code first, digits only (e.g. 91XXXXXXXXXX).
PUBLIC_WHATSAPP_NUMBER=
PUBLIC_INSTAGRAM_URL=
PUBLIC_LINKEDIN_URL=

# --- Brand journey enquiry calendar (/journey) --------------------------------
# Live booking via Cal.com (API v2). With both set, the calendar shows real free
# slots and creates confirmed bookings; Cal.com sends the invitations.
CALCOM_API_KEY=
# Numeric id of the Cal.com event type to book (e.g. a 30-minute discovery call).
CALCOM_EVENT_TYPE_ID=
# Without Cal.com: office hours the calendar may offer. The chosen time is sent
# with the enquiry email as a REQUEST, never shown as confirmed. Leave
# BOOKING_HOURS blank and visitors pick a preferred day only.
BOOKING_HOURS=
# e.g. 10:00-13:00,14:00-18:00 above; days default to mon-fri.
BOOKING_DAYS=
# IANA zone for displayed times (default Asia/Kolkata).
BOOKING_TIMEZONE=
# Slot length in minutes (default 30), minimum notice in hours (default 24),
# how many days ahead visitors can book (default 60).
BOOKING_SLOT_MINUTES=
BOOKING_LEAD_HOURS=
BOOKING_HORIZON_DAYS=
